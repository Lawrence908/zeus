# zeus/.env.example — Copy to .env and fill in values
# ============================================================

# --- Environment ---
# "dev" = Claude API + verbose logging (typically a workstation with a larger GPU)
# "prod" = Ollama local + structured logging (typically an always-on server)
ZEUS_ENV=dev

# --- Deployer identity ---
# Used to render personalized prompt templates (zeus/prompts/templates/*.md).
# ZEUS_USER_NAME is the name the assistant will use when addressing you.
# ZEUS_USER_POSSESSIVE is the matching possessive ("their", "his", "her").
# Both default to generic ("the user" / "their") if unset.
#ZEUS_USER_NAME=
#ZEUS_USER_POSSESSIVE=

# Partition key for the memory and knowledge stores. Keep stable across
# restarts — changing it orphans prior facts. Defaults to "user" when unset.
#ZEUS_USER_ID=user

# Optional: path to a directory with fully-overridden prompt .md files.
# Loader prefers these over the tracked templates. Defaults to
# ./zeus/prompts/overrides/ (gitignored); set to a different path if you
# store overrides elsewhere.
#ZEUS_PROMPT_OVERRIDE_DIR=

# ─── LLM provider override (optional) ─────────────────────────────────────────
# Applies to extraction LLM selection only (not embeddings).
# "claude" → force cloud Claude in any environment (requires ANTHROPIC_API_KEY)
# "ollama" → force local Ollama in any environment (requires Ollama + pulled model)
# Unset    → provider is derived from ZEUS_ENV defaults (dev=claude, prod=ollama)
#
# Supported testing matrix:
# - dev + claude (default): cloud baseline / highest quality checks
# - dev + ollama: local model comparison without changing environment context
# - prod + ollama (default): deployment-realistic local inference path
# - prod + claude: cloud A/B validation or quality debugging (costs $)
#
#ZEUS_LLM=claude
ZEUS_LLM=ollama

# --- Anthropic (dev only) ---
# Required when ZEUS_ENV=dev. Get key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM Models ---
# Provider-specific extraction model names (used regardless of ZEUS_ENV when forced via ZEUS_LLM)
ZEUS_CLAUDE_MODEL=claude-sonnet-4-6
# Must match the *Docker* Ollama (Zeus stack), not host `ollama list`:
#
#   docker compose exec ollama ollama list
#
#   docker compose exec ollama ollama pull llama3
# ZEUS_OLLAMA_MODEL=llama3:latest
#   docker compose exec ollama ollama pull llama3.1:8b-instruct-q4_K_M
# (Tag must match `docker compose exec ollama ollama list` exactly.)
ZEUS_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M


# Backward-compatible aliases still supported by code:
# ZEUS_DEV_MODEL (Claude fallback), ZEUS_PROD_MODEL (Ollama fallback)
#ZEUS_DEV_MODEL=claude-sonnet-4-6-20250514
#ZEUS_PROD_MODEL=qwen2.5:7b-instruct-q4_K_M
# Embedding model (both envs, via Ollama)
#   docker compose exec ollama ollama pull nomic-embed-text:v1.5
ZEUS_EMBED_MODEL=nomic-embed-text:v1.5

# --- Qdrant (Mnemosyne vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=zeus_memories
# Compose only: Qdrant log level (default in compose.yaml is WARN — less HTTP access noise)
#QDRANT_LOG_LEVEL=WARN

# --- Knowledge layer (zeus_knowledge collection) ---
ZEUS_KNOWLEDGE_COLLECTION=zeus_knowledge
# Hybrid retrieval: dense + BM25 sparse with Qdrant-native RRF fusion.
# +7-18% MRR on personal-notes corpora (research). Requires fastembed.
# Turn off only if you need to roll back to dense-only for debugging.
ZEUS_KNOWLEDGE_HYBRID=1
# Cross-encoder rerank pass: BAAI/bge-reranker-v2-m3, ~1GB model, CPU-friendly.
# First call downloads from HuggingFace. Runs on CPU by default. Do not load it
# onto the production chat GPU if that card is VRAM-constrained — put it on CPU
# or the dev GPU instead.
ZEUS_KNOWLEDGE_RERANK=0
#ZEUS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#ZEUS_RERANKER_DEVICE=cpu
#ZEUS_RERANKER_FP16=0
# Default retrieval top_k and candidate pool (candidate_k feeds the reranker).
ZEUS_KNOWLEDGE_SEARCH_TOP_K=5

# --- Ollama ---
OLLAMA_URL=http://localhost:11435
OLLAMA_PORT=11435
# Timeout (seconds) for Ollama embedding calls. Prevents indefinite hangs when
# Ollama is overloaded. Applies to MemoryStore / KnowledgeStore embed calls.
# Set to 0 to disable.
OLLAMA_EMBED_TIMEOUT_SEC=120
# Max retries per chunk on transient Ollama/embed failures (0 = unlimited).
# With OLLAMA_EMBED_TIMEOUT_SEC=120 and backoff ~60s, 10 retries ≈ 30 min max.
IRIS_INGEST_TRANSIENT_MAX_RETRIES=10
# Max parallel requests Ollama will handle
OLLAMA_NUM_PARALLEL=2
# Max models loaded in VRAM simultaneously. Use 1 only if you must (tight VRAM);
# Zeus hits Ollama for embeddings + chat, so 1 causes heavy model swapping.
OLLAMA_MAX_LOADED_MODELS=2
# Compose only: llama.cpp/GGML stderr verbosity (default error — quieter model-load traces)
#OLLAMA_GGML_LOG_LEVEL=error

# --- Zeus Core (FastAPI) ---
ZEUS_CORE_PORT=8203

# --- Phaos (voice visualization) ---
# Optional shared secret for POST /voice-state/publish (host-native Orpheus → Core).
# Leave unset for local-only dev; set in prod if the endpoint is reachable off-host.
#ZEUS_VOICE_STATE_SECRET=
# Orpheus can POST here when Core runs in Docker / another host:
#ZEUS_VOICE_STATE_PUBLISH_URL=http://localhost:8203/voice-state/publish

# --- Future: Voice (Orpheus) ---
# ORPHEUS_VOICE_ID=<your_luxtts_voice_id>
# WHISPER_MODEL=large-v3
# VOICEBOX_URL=http://localhost:5050
# WAKE_WORD_MODEL=hey_zeus

# --- Safety (Aegis) — in-process policies + optional NVIDIA stack on host ---
# Zeus YAML rules under zeus/safety/policies/ (standard, ingest, voice, memory, …).
# Set to 1 to filter chat/voice query output and orchestration /orchestration/call responses.
#ZEUS_AEGIS_ENABLED=1
#
# Chat/voice policy file (without .yaml). Falls back to NEMOCLAW_POLICY, then standard.
#ZEUS_AEGIS_POLICY=standard
#
# Legacy alias for policy name (matches agent YAML policy ids: standard, ingest, voice, memory, default).
#NEMOCLAW_POLICY=default
#
# Reserved: HTTP endpoint if NVIDIA exposes a sidecar API later (unset = evaluate in-process only).
#NEMOCLAW_RUNTIME_URL=
#
# OpenShell is part of the host NemoClaw install (kernel/sandbox runtime), not Zeus Core.
#OPENSHELL_SANDBOX=true

# --- Newsletter Digest (Iris source + API) ---
# IMAP credentials for fetching newsletter emails
#NEWSLETTER_IMAP_HOST=imap.gmail.com
#NEWSLETTER_IMAP_USER=your-email@gmail.com
#NEWSLETTER_IMAP_PASS=your-gmail-app-password
#NEWSLETTER_IMAP_PORT=993
#NEWSLETTER_MAILBOX=INBOX
# JSON dict mapping newsletter type to sender email address
#NEWSLETTER_SOURCES={"tldr": "dan@tldrnewsletter.com"}
# Directory for generated audio files
#NEWSLETTER_AUDIO_DIR=zeus/data/audio

# --- Session persistence ---
# "memory" (default) = in-process dict (lost on restart)
# "sqlite" = SQLite file (survives restarts)
ZEUS_SESSION_BACKEND=memory
# Path to SQLite DB file when ZEUS_SESSION_BACKEND=sqlite
#ZEUS_SESSION_DB_PATH=zeus/data/sessions.db

# Total heuristic chat-context budget; 1/3 memories, 2/3 session block.
ZEUS_CONTEXT_MAX_TOKENS=6144
# Max newest turns considered before packing (0 = unlimited).
ZEUS_SESSION_PACK_MAX_TURNS=150
# Raw turns kept after each summary compaction.
ZEUS_SESSION_KEEP_RAW_TURNS=150
# When stored turn count reaches this, older turns are summarized + compacted.
ZEUS_SESSION_SUMMARY_AT_TURNS=200
ZEUS_SESSION_DB_PATH=zeus/data/sessions.db

# Per-request Ollama context window for the chat path. Default is 4096 in
# Ollama itself, which truncates the system prompt + tool defs when
# ZEUS_TOOLS_ENABLED=1. 8192 fits comfortably for the Olympian pack.
# Set to 0 (or empty) to fall back to the model's default.
ZEUS_OLLAMA_NUM_CTX=8192

# --- Telegram bridge ---
# Note: docker compose env_file does NOT strip inline `# ...` comments,
# so each comment must live on its own line above the variable.
# 1 to start the bot on lifespan.
TELEGRAM_ENABLED=0
# BotFather token.
TELEGRAM_BOT_TOKEN=
# Comma- or newline-separated chat IDs; empty = allow all.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional policy name for outgoing-message safety check (e.g. "voice", "personal").
TELEGRAM_AEGIS_POLICY=


# --- Reference layer (Phase 2, LAB-NEW-C) ---
# Live external sources queried at chat time; never ingested.
ZEUS_KIWIX_ENABLED=1
# Base URL of your kiwix-serve instance. Can be a local container
# (http://kiwix:8080 or http://localhost:8080) or a public TLS endpoint behind
# Caddy + Cloudflare. Leave empty to disable the live kiwix proxy.
ZEUS_KIWIX_URL=
# Cloudflare Access service token (Zero Trust → Access → Service Auth).
# Add a "Service Auth" policy to the kiwix Access app that includes this token,
# then set both values here. Leave empty if the endpoint is public.
#ZEUS_KIWIX_CF_ACCESS_CLIENT_ID=
#ZEUS_KIWIX_CF_ACCESS_CLIENT_SECRET=
ZEUS_NOMAD_ENABLED=0
#ZEUS_NOMAD_URL=
ZEUS_REFERENCE_SEARCH_TOP_K=5

# --- Kiwix ZIM ingest (Phase 2.5) ---
# Disk-side counterpart to the live Reference layer above: walks ZIM files in
# ZEUS_KIWIX_ZIM_DIR and ingests their articles into zeus_knowledge. Small
# curated ZIMs only — large ZIMs (Wikipedia, Wiktionary, etc.) should be
# queried live via KiwixClient, not ingested. Bind-mounted read-only into
# zeus-core via compose.override.yaml.
ZEUS_KIWIX_ZIM_DIR=/path/to/your/kiwix/zims
# Hard cap on per-ZIM file size. Anything above this is logged and skipped.
# Raise only if you've thought about the Qdrant footprint.
ZEUS_KIWIX_MAX_ZIM_MB=2048

# --- KAIROS background agent daemon (LAB-330) ---
# Observe-decide-act loop. Default OFF. Read-only by default; adding
# olympian_shell to the allowlist requires ZEUS_SHELL_ENABLED=1 and is
# not recommended.
ZEUS_KAIROS_ENABLED=0
KAIROS_INTERVAL_MINUTES=60
KAIROS_MAX_ACTIONS_PER_CYCLE=5
ZEUS_KAIROS_TOOL_ALLOWLIST=zeus_memory_search

# --- KRONOS cron-driven scheduler ---
# Deterministic job runner (Kairos's "measured time" sibling). Default OFF;
# flip to 1 per environment once seed jobs in zeus/data/kronos.yaml are
# reviewed. Seed is insert-or-skip by id, so edits to live jobs via the API
# survive restarts.
ZEUS_KRONOS_ENABLED=0
# SQLite DB path for job definitions and run history.
ZEUS_KRONOS_DB_PATH=zeus/data/kronos.db
# Scheduler tick cadence. Sub-minute cron precision is not supported.
ZEUS_KRONOS_TICK_SECONDS=30
# Max jobs dispatched concurrently; excess queue behind a semaphore.
ZEUS_KRONOS_MAX_CONCURRENT=3
# Gate for POST /kronos/* mutations (manual run, create, update, delete).
ZEUS_KRONOS_ALLOW_WRITE=0
# Shell-mode executor (Phase 3). Double-gated: enable flag + regex allowlist.
ZEUS_KRONOS_SHELL_ENABLED=0
ZEUS_KRONOS_SHELL_ALLOWLIST=
# Memory namespace for the audit trail written after each run.
ZEUS_KRONOS_MEMORY_NAMESPACE=kronos_execution_log



# =============================================================================
# SMALL-TASK LLM LAYER (zeus/core/small_llm.py)
# =============================================================================
# General-purpose provider router for batch / structured-output tasks that
# shouldn't live on the chat LLM path. First caller is MemoryStore fact
# extraction; future callers: chat-session titles, newsletter bullets,
# privacy classifier, tool-argument hints, KAIROS observation summaries.
#
# Privacy tiers:
#   tier 1 = SAFE for PII (Anthropic, OpenAI paid, Gemini paid, DeepInfra ZDR,
#            Mistral paid, Groq with ZDR, local Ollama)
#   tier 2 = OK for depersonalised (Cerebras, SambaNova free, Together without
#            ZDR, OpenRouter :free with data-policy filter)
# Callers pass min_privacy_tier. Tier-2-only providers are statically removed
# from the chain when min_privacy_tier=1.
#
# ⚠ GEMINI FREE TIER TRAINS ON YOUR INPUTS (confirmed live in Google's
#   Additional Terms, April 2026). Use paid tier only for anything with PII.
#   Billing-enabled key flips Gemini from "trains" to SAFE (tier 1).

# Ordered provider chain. Earlier = preferred; fallbacks trigger on 429/5xx/timeout.
ZEUS_SMALL_LLM_CHAIN=anthropic_haiku,ollama
# Daily USD cap across paid providers. Once hit, remaining calls route to free
# providers only or fail cleanly. Resets at UTC midnight.
ZEUS_SMALL_LLM_DAILY_USD_CAP=2.00
# SQLite usage log path (persisted via zeus_data Docker volume).
ZEUS_SMALL_LLM_USAGE_DB=zeus/data/small_llm_usage.db
# 429 backoff for OpenAI-compat providers (gemini_paid, groq, openrouter).
# Comma-separated ms delays per retry; empty disables retries.
# Default keeps Gemini in play under short bursts without waking Haiku.
#ZEUS_SMALL_LLM_RETRY_DELAYS_MS=2000,5000,15000

# -- Anthropic Haiku (tier 1, paid) ------------------------------------------
# Quality fallback. Haiku-class (not Sonnet) to cap spend.
#ZEUS_ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
#ZEUS_ANTHROPIC_HAIKU_ALLOWED_MODELS=claude-haiku-4-5-20251001,claude-haiku-4-5

# -- Ollama small-task (tier 1, local) ---------------------------------------
# Last-resort fallback. Task-J showed Qwen hallucinates CJK during extraction,
# so this is not the primary slot. Your chat LLM is unaffected — it uses
# _run_llm() in zeus/core/query.py.
#ZEUS_OLLAMA_SMALL_MODEL=qwen2.5:7b-instruct
#ZEUS_OLLAMA_SMALL_ALLOWED_MODELS=qwen2.5:7b-instruct,llama3.1:8b-instruct-q4_K_M,qwen3:8b
# Read timeout for structured-output calls. Cold qwen2.5:7b loads can exceed
# the embed timeout; 300s handles the eviction-and-reload case when VRAM is
# shared with embeddings / reranker. Raise for slower hosts.
#ZEUS_OLLAMA_SMALL_READ_TIMEOUT_SEC=300

# -- Gemini (tier 1 when paid, TIER-2-only on free) --------------------------
# Primary when wired. Billing must be enabled on the key for tier-1 usage.
#GOOGLE_API_KEY=
#ZEUS_GEMINI_PAID_MODEL=gemini-2.5-flash-lite
#ZEUS_GEMINI_PAID_ALLOWED_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash

# -- Groq (tier 1 with ZDR) --------------------------------------------------
# Orthogonal-failure-mode free fallback. 14.4K calls/day free; enable ZDR in
# the Groq console to stay in tier 1.
#GROQ_API_KEY=
#ZEUS_GROQ_MODEL=llama-3.3-70b-versatile
#ZEUS_GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile,llama-4-scout-17b

# -- DeepInfra (tier 1, paid ZDR default) ------------------------------------
#DEEPINFRA_API_KEY=
#ZEUS_DEEPINFRA_MODEL=Qwen/Qwen3-32B
#ZEUS_DEEPINFRA_ALLOWED_MODELS=Qwen/Qwen3-32B,deepseek-ai/DeepSeek-V3

# -- Cerebras (tier 2 only — retention policy unclear) -----------------------
#CEREBRAS_API_KEY=
#ZEUS_CEREBRAS_MODEL=gpt-oss-120b
#ZEUS_CEREBRAS_ALLOWED_MODELS=gpt-oss-120b,qwen-3-235b-instruct

# =============================================================================
# OPENROUTER — pass-through for other providers (tier depends on upstream)
# =============================================================================
# OpenRouter aggregates many providers. Privacy tier depends on upstream model:
# ":free" tagged models generally retain data → TIER 2 only. Paid models on
# providers with ZDR (Anthropic, OpenAI, Mistral) are tier 1.

#OPENROUTER_API_KEY=sk-or-v1-...
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#ZEUS_OPENROUTER_MODEL=deepseek/deepseek-chat-v3
#ZEUS_OPENROUTER_ALLOWED_MODELS=deepseek/deepseek-chat-v3,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,openai/gpt-4o-mini,openai/gpt-5-nano,google/gemini-2.5-flash-lite,anthropic/claude-sonnet-4.5

# =============================================================================
# CHAT-PATH TOOL USE (Zeus 10 — chat-path tool loop)
# =============================================================================
# Opt-in feature flag for the chat-path tool-call loop (QueryEngine.query).
# When off, chat behaviour is byte-identical to pre-tool-use. Per-query
# tool-call cap guards against runaway loops. See zeus/docs/tool-use-spec.md.
ZEUS_TOOLS_ENABLED=0
ZEUS_TOOLS_MAX_CALLS_PER_QUERY=5

# Tool-result cache — short TTL LRU for cacheable tools (web_search yes,
# current_time no). Set TTL to 0 to disable caching entirely.
ZEUS_TOOL_CACHE_TTL_SECONDS=300
ZEUS_TOOL_CACHE_MAX_ENTRIES=256

# Brave Search API key — needed to register the web_search tool. Free tier is
# 1 qps / 2000 queries per month. Without a key the tool is silently not
# registered, and the tool loop is a no-op even with ZEUS_TOOLS_ENABLED=1.
#BRAVE_API_KEY=

# Tavily Search API key — second provider used by the deep_research Kronos
# job. Runs in parallel with Brave per query and merges URL-deduped hits, so
# each provider widens the source pool for the report. Free tier is 1000
# queries per month (https://tavily.com). Without a key the deep_research
# job silently falls back to Brave-only.
#TAVILY_API_KEY=

# Jina Reader API key — used by the deep_research Kronos job to fetch full
# page content (clean markdown) for the top result URLs per sub-question.
# Reader is FREE without a key but rate-limited; setting this raises the
# limit (https://jina.ai/reader). Without a key fetches still happen but
# will throttle on bursty deep runs.
#JINA_READER_API_KEY=

# Output directory for deep_research reports. Default lives under the repo so
# reports are visible alongside other docs and can be ingested back into the
# Zeus knowledge store. Override per-environment if you prefer ~/research or
# similar.
#ZEUS_DEEP_RESEARCH_DIR=/home/chris/zeus/docs/research

# Default timezone used by the current_time tool when no timezone is passed.
# IANA names only (e.g. America/Vancouver, Europe/London). Falls back to UTC.
#ZEUS_DEFAULT_TIMEZONE=America/Vancouver

# ─── Zeus OS (tiling-WM web shell at /os/) ────────────────────────────────────
# Filesystem roots the File Manager + grep can READ. Comma-separated; tilde
# expanded; symlinks resolved. Defaults to a useful subset of container paths;
# broaden to taste. When the PTY upgrades to host SSH (Phase 1.5) re-root these
# to /home/chris/... paths.
#ZEUS_OS_FS_ROOTS=/app/zeus,/app/zeus/data,/root/.zeus

# Subset of the above that the File Manager + editor are allowed to WRITE to.
# Must be a subset of ZEUS_OS_FS_ROOTS in practice.
#ZEUS_OS_FS_WRITE_ROOTS=/root/.zeus

# Master switch for writes through the WM. Off by default; flip when you trust
# the surface.
#ZEUS_OS_FS_WRITE_ENABLED=0

# Where the WM persists user prefs (theme, modifier key, pinned workspaces,
# keybind overrides). Defaults to ~/.zeus/zeus-os/ which is already writable
# inside the container via the existing bind mount.
#ZEUS_OS_CONFIG_DIR=/root/.zeus/zeus-os

# PTY: working directory for new terminals (container path in Phase 1).
#ZEUS_OS_PTY_CWD=/app/zeus

# PTY: shell to spawn. Defaults to $SHELL or /bin/bash.
#ZEUS_OS_PTY_SHELL=/bin/bash

# PTY: Phase 1.5 upgrade — flip to 1 to ssh out to the host instead of running
# a container shell. Requires:
#   ssh-keygen -t ed25519 -N "" -C zeus-os@container -f ~/.ssh/id_ed25519_zeus_os
#   plus a restricted line in ~/.ssh/authorized_keys (from=docker-bridge only).
# The compose.override.yaml in this repo handles the bind-mount + extra_hosts
# when this is enabled.
#ZEUS_OS_PTY_HOST_SSH=0
#ZEUS_OS_PTY_SSH_HOST=chris@host.docker.internal
#ZEUS_OS_PTY_SSH_IDENTITY=/root/.ssh/id_ed25519_zeus_os
#ZEUS_OS_PTY_SSH_COMMAND=bash -il
# SSH host-key cache. Default lives under the writable ~/.zeus mount so it
# survives container rebuilds.
#ZEUS_OS_PTY_SSH_KNOWN_HOSTS=/root/.zeus/zeus-os/known_hosts

# GPU stats source. Choose one:
#   - ZEUS_OS_GPU_LOCAL=1: in-container nvidia-smi (needs GPU reservation;
#     not enabled in stock compose).
#   - ZEUS_OS_GPU_SSH=1: nvidia-smi over the same host-SSH used for the PTY.
#     ControlMaster keeps the SSH connection multiplexed so 1Hz polling is cheap.
#ZEUS_OS_GPU_LOCAL=0
#ZEUS_OS_GPU_SSH=0
