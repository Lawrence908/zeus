# ============================================
# Zeus Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================

# --------------------------------------------
# Core Settings
# --------------------------------------------

# Environment mode: dev or prod
# - dev: Uses Claude API for LLM operations
# - prod: Uses Ollama with local models
ZEUS_ENV=dev

# --------------------------------------------
# Anthropic / Claude API (Dev Mode)
# --------------------------------------------

# Required for dev mode — get key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --------------------------------------------
# Qdrant Vector Database
# --------------------------------------------

# Qdrant server host (use "qdrant" when running in docker-compose)
QDRANT_HOST=localhost

# Qdrant REST API port
QDRANT_PORT=6333

# --------------------------------------------
# Ollama (Prod Mode)
# --------------------------------------------

# Ollama server URL (use "http://ollama:11434" in docker-compose)
OLLAMA_HOST=http://localhost:11434

# --------------------------------------------
# Model Configuration (Optional Overrides)
# --------------------------------------------

# LLM model for extraction and inference
# Dev default: claude-sonnet-4-20250514
# Prod default: qwen2.5:7b-instruct-q4_K_M
# ZEUS_LLM_MODEL=claude-sonnet-4-20250514

# Embedding model (via Ollama)
# Default: nomic-embed-text
# ZEUS_EMBED_MODEL=nomic-embed-text

# --------------------------------------------
# Service Ports (Optional Overrides)
# --------------------------------------------

# Zeus Core API port
# ZEUS_CORE_PORT=8000

# Qdrant gRPC port (advanced usage)
# QDRANT_GRPC_PORT=6334

# --------------------------------------------
# Future Services (Placeholders)
# --------------------------------------------

# WhisperLiveKit STT
# WHISPER_HOST=http://localhost:9000

# Voicebox TTS  
# VOICEBOX_HOST=http://localhost:9001

# Zeus Context API (Oracle)
# ORACLE_HOST=http://localhost:8001

# --------------------------------------------
# Privacy & Security (Future)
# --------------------------------------------

# NemoClaw privacy router toggle
# NEMOCLAW_ENABLED=false

# Data encryption at rest
# ZEUS_ENCRYPT_DATA=false
