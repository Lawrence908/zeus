# zeus/.env.example — Copy to .env and fill in values
# ============================================================

# --- Environment ---
# "dev" = Claude API + verbose logging (5080 tower)
# "prod" = Ollama local + structured logging (3080 server / Olympus)
ZEUS_ENV=dev

# --- Anthropic (dev only) ---
# Required when ZEUS_ENV=dev. Get key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM Models ---
# Dev extraction model (Claude API)
ZEUS_DEV_MODEL=claude-sonnet-4-6-20250514
# Prod extraction model (Ollama)
ZEUS_PROD_MODEL=qwen2.5:7b-instruct-q4_K_M
# Embedding model (both envs, via Ollama)
ZEUS_EMBED_MODEL=nomic-embed-text

# --- Qdrant (Mnemosyne vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=zeus_memories

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_PORT=11434
# Max parallel requests Ollama will handle
OLLAMA_NUM_PARALLEL=2
# Max models loaded in VRAM simultaneously
OLLAMA_MAX_LOADED_MODELS=1

# --- Zeus Core (FastAPI) ---
ZEUS_CORE_PORT=8000

# --- Future: Voice (Orpheus) ---
# ORPHEUS_VOICE_ID=<your_luxtts_voice_id>
# WHISPER_MODEL=large-v3
# VOICEBOX_URL=http://localhost:5050
# WAKE_WORD_MODEL=hey_zeus

# --- Future: Safety (Aegis) ---
# NEMOCLAW_POLICY=default
# OPENSHELL_SANDBOX=true
